<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 600" width="100%" height="100%">
  <defs>
    <!-- Solid Rich Black Background -->
    <rect width="600" height="600" fill="#050505" />

    <!-- Metallic Silver Gradient for Wings and Main Title -->
    <linearGradient id="silverGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" />
      <stop offset="40%" stop-color="#cfcfcf" />
      <stop offset="70%" stop-color="#8c8c8c" />
      <stop offset="100%" stop-color="#e6e6e6" />
    </linearGradient>

    <!-- Subtle Soft Glow -->
    <filter id="softGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="3" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- Background -->
  <rect width="600" height="600" fill="#000000" />

  <!-- Center Winged Icon / Eagle Wings (Inspired by your image) -->
  <g filter="url(#softGlow)" transform="translate(0, -20)">
    <!-- Central Body / Tail -->
    <path d="M 300 240 L 290 320 L 300 350 L 310 320 Z" fill="url(#silverGrad)" />
    <path d="M 293 310 L 300 345 L 307 310 Z" fill="#111111" />
    <path d="M 288 295 L 300 335 L 312 295 Z" fill="url(#silverGrad)" />
    
    <!-- Left Wing -->
    <path d="M 290 250 
             C 240 220, 170 200, 110 215 
             C 160 235, 210 255, 250 280 
             C 220 270, 180 265, 140 275 
             C 180 290, 230 295, 275 305 
             C 255 315, 235 320, 215 325 
             C 245 330, 275 325, 290 310 Z" 
          fill="url(#silverGrad)" />

    <!-- Right Wing (Symmetric) -->
    <path d="M 310 250 
             C 360 220, 430 200, 490 215 
             C 440 235, 390 255, 350 280 
             C 380 270, 420 265, 460 275 
             C 420 290, 370 295, 325 305 
             C 345 315, 365 320, 385 325 
             C 355 330, 325 325, 310 310 Z" 
          fill="url(#silverGrad)" />
  </g>

  <!-- Typography: Clean, Modern, No Cursive / No Vel Letters -->
  <!-- Main Name: SUBASHITH -->
  <text x="300" y="395" 
        font-family="'Segoe UI', Helvetica, Arial, sans-serif" 
        font-weight="700" 
        font-size="42" 
        fill="url(#silverGrad)" 
        text-anchor="middle" 
        letter-spacing="10" 
        filter="url(#softGlow)">
    SUBASHITH
  </text>

  <!-- Subtitle: POWERED BY -->
  <text x="300" y="440" 
        font-family="'Segoe UI', Helvetica, Arial, sans-serif" 
        font-weight="300" 
        font-size="16" 
        fill="#aaaaaa" 
        text-anchor="middle" 
        letter-spacing="8">
    POWERED BY
  </text>
</svg>